{
  "listen": "10.0.0.10:8085",
  "api_keys": [
    { "id": "monitoring", "sha256": "REPLACE_WITH_OUTPUT_OF_hvapi_hash-key" }
  ],
  "allowed_cidrs": [ "10.0.0.0/24" ],
  "rate_limit": { "per_second": 10, "burst": 20 },
  "log_file": "hvapi.log",
  "log_rotate": { "max_mb": 10, "keep": 5 },
  "poll": { "state_seconds": 10, "heavy_seconds": 60 },
  "events": { "hours": 24, "max_per_log": 500 },
  "tls": { "cert_file": "hvapi-cert.pem", "key_file": "hvapi-key.pem", "min_version": "1.2" }
}
